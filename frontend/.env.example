# ---------------------------------------------------------------------------
# EduRewards frontend — copy to frontend/.env.local to override locally.
# Vite bakes these into the bundle at BUILD time; they are not read at runtime,
# so changing one means rebuilding and redeploying the frontend.
# ---------------------------------------------------------------------------

# Where the API lives.
#
# Leave unset when the UI and the API answer on the same domain. The app then
# calls the relative path /api/v1, which is what `npm run dev` relies on (Vite
# proxies /api to http://localhost:4000).
#
# Set it to an absolute URL when the UI is hosted separately from the API —
# for example a static host for the UI and a Node host for the backend. The
# backend's FRONTEND_URL must name this site's origin or CORS will reject it.
#
# VITE_API_URL=https://api.your-domain.com/api/v1
