# ---------------------------------------------------------------------------
# EduRewards — copy this file to backend/.env before running the API.
# Never commit a real .env file.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
APP_VERSION=1.0.0
LOG_LEVEL=info

# --- Database ---------------------------------------------------------------
# SQLite file, relative to the backend/ directory.
DATABASE_URL="file:./data/edurewards.db"

# --- Authentication ---------------------------------------------------------
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-me-with-a-long-random-value
JWT_REFRESH_SECRET=replace-me-with-a-different-long-random-value
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# --- Encryption -------------------------------------------------------------
# Used for bank account and PAN encryption at rest. Must be at least 32 characters.
# Rotating this value makes existing encrypted payout details unreadable.
ENCRYPTION_KEY=replace-me-with-at-least-thirty-two-characters

# --- URLs and cookies -------------------------------------------------------
FRONTEND_URL=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:4000
COOKIE_SECURE=false
# COOKIE_DOMAIN=.yourdomain.com

# lax | strict | none
# Use 'none' (with COOKIE_SECURE=true, so HTTPS on both sides) only when the
# frontend is served from a different site than this API. A 'lax' cookie is
# never sent cross-site, so sessions would stop surviving a page refresh.
COOKIE_SAMESITE=lax

# --- Uploads ----------------------------------------------------------------
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5

# --- Email ------------------------------------------------------------------
# console | smtp | none
EMAIL_PROVIDER=console
EMAIL_FROM="EduRewards <no-reply@edurewards.local>"

# --- Rate limiting ----------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10

# --- Background jobs --------------------------------------------------------
ENABLE_JOBS=true
LIVENESS_CHECK_CRON_MINUTES=360

# --- Seeding ----------------------------------------------------------------
# Password applied to every seeded demo account. Development only.
SEED_PASSWORD=EduRewards#2026
